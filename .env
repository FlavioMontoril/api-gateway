# URL do Frontend (ReactJS/Vite) para as configurações de CORS
# Múltiplas origens são definidas como lista indexada no application.properties
FRONTEND_URL=http://localhost:5173

# APIS (URLs internas dos microsserviços)
AUTH_SERVICE_URL=http://localhost:8081
TASK_SERVICE_URL=http://localhost:8082

# SOCKET — SockJS usa http:// (NÃO ws://).
# O Gateway converte automaticamente para ws:// apenas no upgrade real do WebSocket.
# Usar ws:// quebra as requisições HTTP do SockJS (/ws/info, /ws/xhr, etc.)
AUTH_SOCKET_URL=http://localhost:8081

# Chave secreta para a validação dos tokens JWT (Se os serviços partilharem a mesma chave)
JWT_SECRET=minha_chave_bem_secreta_auth_server