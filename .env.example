# URL do Frontend (ReactJS/Vite) para as configurações de CORS
# Múltiplas origens são definidas como lista indexada no application.properties
FRONTEND_URL=

# APIS (URLs internas dos microsserviços)
AUTH_SERVICE_URL=
TASK_SERVICE_URL=

# SOCKET — URI de WebSocket DEVE usar ws:// (não http://)
AUTH_SOCKET_URL=

# Chave secreta para a validação dos tokens JWT (Se os serviços partilharem a mesma chave)
JWT_SECRET=